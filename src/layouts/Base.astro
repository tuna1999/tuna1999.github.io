---
interface Props { title: string; description?: string; }
const { title, description = 'Security research, malware analysis and reverse engineering.' } = Astro.props;
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#0a0f14" />
  <meta name="description" content={description} />
  <link rel="canonical" href={new URL(path, Astro.site)} />
  <link rel="alternate" type="application/rss+xml" title="RSS" href="/rss.xml" />
  <title>{title} · Tuna Security Research</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
</head>
<body>
  <div class="scanline"></div>
  <header class="site-header">
    <div class="shell header-inner">
      <a href="/" class="brand"><span class="brand-icon">T<span class="brand-slash">/</span></span><span>TUNA<span class="brand-muted">/SEC</span></span></a>
      <nav aria-label="Main navigation">
        <a class:active={path === '/'} href="/">Home</a>
        <a class:active={path.startsWith('/blog')} href="/blog/">Research</a>
        <a class:active={path.startsWith('/tags')} href="/tags/">Topics</a>
        <a href="https://github.com/tuna1999" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
      </nav>
    </div>
  </header>
  <main><slot /></main>
  <footer class="site-footer"><div class="shell footer-inner"><span>© {new Date().getFullYear()} TUNA SECURITY RESEARCH</span><span>BUILT WITH ASTRO · <a href="/rss.xml">RSS ↗</a></span></div></footer>
</body>
</html>
<style is:global>
  :root{color-scheme:dark;--bg:#0a0f14;--panel:#0e151c;--panel2:#111b24;--border:#23303b;--text:#e8eff4;--muted:#91a1ad;--green:#7bedb8;--blue:#78b8e6}
  *{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--bg);color:var(--text);font-family:Inter,system-ui,sans-serif;font-size:15px;line-height:1.7}
  a{color:inherit;text-decoration:none}a:hover{color:var(--green)}.shell{max-width:1120px;padding:0 28px;margin:0 auto}
  .site-header{border-bottom:1px solid var(--border);background:#0a0f14ee;position:sticky;top:0;z-index:5;backdrop-filter:blur(14px)}
  .header-inner{height:76px;display:flex;align-items:center;justify-content:space-between;gap:18px}
  .brand{font-weight:800;letter-spacing:.09em;display:flex;align-items:center;gap:13px;font-size:15px}.brand-icon{display:grid;place-items:center;font:600 19px 'DM Mono',monospace;background:#17352d;color:var(--green);border:1px solid #366856;border-radius:7px;width:39px;height:39px}.brand-slash{color:#e9fff4}.brand-muted{color:var(--green)}
  nav{display:flex;align-items:center;gap:30px}nav a{font:500 12px 'DM Mono',monospace;color:#aab8c2}nav a.active{color:var(--green)}
  .site-footer{border-top:1px solid var(--border);margin-top:95px;color:var(--muted);font:11px 'DM Mono',monospace}.footer-inner{display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;padding-top:28px;padding-bottom:28px}
  .eyebrow{font:500 11px 'DM Mono',monospace;letter-spacing:.14em;color:var(--green);text-transform:uppercase}.muted{color:var(--muted)}
  .page-heading{font-size:clamp(32px,5vw,52px);letter-spacing:-.045em;line-height:1.13;margin:18px 0}.page-intro{max-width:640px;color:var(--muted);font-size:16px}
  .section-heading{font-size:20px;letter-spacing:-.03em;margin:0}.section-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;gap:14px}
  .post-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}.post-card{background:var(--panel);border:1px solid var(--border);border-radius:10px;padding:26px;transition:border-color .2s,transform .2s}.post-card:hover{border-color:#49826a;transform:translateY(-2px)}.post-card h3{font-size:20px;letter-spacing:-.035em;line-height:1.4;margin:15px 0 9px}.post-card p{color:var(--muted);font-size:13px;margin:0 0 26px}.meta{font:11px 'DM Mono',monospace;color:#92a7af}.meta .category{color:var(--green)}.tag{display:inline-block;padding:4px 9px;border:1px solid #30424a;border-radius:4px;font:10px 'DM Mono',monospace;color:#aac0ca;margin:0 5px 5px 0}.tag:hover{border-color:var(--green);color:var(--green)}.post-card footer{display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap}.read-more{font:12px 'DM Mono',monospace;color:var(--green)}
  .prose{font-size:16px;color:#c5d2dc;max-width:790px}.prose h2,.prose h3{color:var(--text);letter-spacing:-.03em;scroll-margin-top:100px}.prose h2{font-size:27px;margin:45px 0 17px}.prose h3{font-size:21px;margin:30px 0 12px}.prose p,.prose ul,.prose ol{margin-bottom:22px}.prose a{color:var(--green);text-decoration:underline;text-underline-offset:4px}.prose strong{color:var(--text)}.prose pre{border:1px solid #293b47;border-radius:8px;padding:19px;overflow:auto;line-height:1.6;font-size:13px}.prose :not(pre)>code{font-family:'DM Mono',monospace;font-size:.87em;padding:2px 5px;border-radius:3px;background:#182731;color:var(--green)}.prose blockquote{border-left:3px solid var(--green);padding:7px 20px;margin:20px 0;background:#101c21;color:#b6c9c7}.prose img{max-width:100%;height:auto}.prose table{display:block;overflow-x:auto;border-collapse:collapse;width:100%;font-size:13px}.prose th,.prose td{border:1px solid var(--border);padding:11px 15px;text-align:left}.prose th{background:var(--panel2)}
  .scanline{pointer-events:none;position:fixed;inset:0;z-index:20;opacity:.025;background:repeating-linear-gradient(to bottom,transparent 0px,transparent 3px,#fff 4px)}
  @media(max-width:700px){.shell{padding:0 18px}.header-inner{height:auto;padding-top:17px;padding-bottom:17px;align-items:flex-start;flex-direction:column}nav{gap:19px;flex-wrap:wrap}.post-grid{grid-template-columns:1fr}.post-card{padding:20px}.site-footer{margin-top:55px}}
</style>
