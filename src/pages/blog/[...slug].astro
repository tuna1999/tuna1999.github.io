---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { publishedPosts, dateLabel } from '../../lib/posts';
export async function getStaticPaths() {
  const posts = await publishedPosts();
  return posts.map(post => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content, headings } = await render(post);
---
<Base title={post.data.title} description={post.data.description}>
  <article class="shell article"><a class="back" href="/blog/">← ALL RESEARCH</a>
  <div class="eyebrow">{post.data.category.toUpperCase()} / {dateLabel(post.data.pubDate)}</div>
  <h1>{post.data.title}</h1><p class="intro">{post.data.description}</p>
  <div class="tags">{post.data.tags.map((tag: string) => <span class="tag">{tag}</span>)}</div>
  <div class="article-line"></div>
  <div class="article-layout"><div class="prose"><Content /></div><aside class="toc"><div>ON THIS PAGE</div>{headings.filter((h: { depth: number }) => h.depth === 2).map((h: { slug: string; text: string }) => <a href={`#${h.slug}`}>{h.text}</a>)}</aside></div>
  <div class="end"><a href="/blog/">← Back to all research</a></div>
  </article>
</Base>
<style>.article{padding-top:67px}.back{font:11px 'DM Mono',monospace;color:var(--muted);display:block;margin-bottom:53px}h1{font-size:clamp(35px,5vw,59px);line-height:1.16;letter-spacing:-.045em;max-width:850px;margin:21px 0}.intro{font-size:18px;color:var(--muted);max-width:760px}.tags{margin-top:26px}.article-line{height:1px;background:var(--border);margin:42px 0}.article-layout{display:grid;grid-template-columns:minmax(0,1fr) 210px;gap:48px}.toc{align-self:start;position:sticky;top:110px;border-left:1px solid var(--border);padding-left:18px;font:12px 'DM Mono',monospace}.toc div{font-size:10px;color:var(--green);margin-bottom:15px}.toc a{display:block;color:var(--muted);margin-bottom:11px;line-height:1.5}.toc a:hover{color:var(--green)}.end{border-top:1px solid var(--border);padding-top:24px;margin-top:60px;color:var(--green);font:12px 'DM Mono',monospace}@media(max-width:850px){.article-layout{grid-template-columns:1fr}.toc{display:none}}</style>
