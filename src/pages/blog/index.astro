---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { publishedPosts } from '../../lib/posts';
const posts = await publishedPosts();
---
<Base title="Research">
  <section class="shell listing">
    <div class="eyebrow">RESEARCH ARCHIVE</div>
    <h1 class="page-heading">Field notes & analysis<span>.</span></h1>
    <p class="page-intro">Technical writeups, repeatable investigations, and experiments at the intersection of security and systems.</p>
    {posts.length > 0 ? (
      <>
        <label class="search-label" for="search">SEARCH THE ARCHIVE</label>
        <input id="search" type="search" placeholder="Search articles, topics, and keywords…" autocomplete="off" />
        <div id="results" class="post-grid">{posts.map(post => <div class="entry" data-search={`${post.data.title} ${post.data.description} ${post.data.tags.join(' ')} ${post.data.category}`.toLowerCase()}><PostCard post={post} /></div>)}</div>
        <p id="empty" hidden>No matching research notes found.</p>
      </>
    ) : (
      <div class="empty-state"><div class="eyebrow">0 PUBLISHED ARTICLES</div><h2>No research published yet.</h2><p>Technical write-ups will appear here when they are ready.</p></div>
    )}
  </section>
</Base>
<script>
  const input = document.querySelector<HTMLInputElement>('#search');
  const entries = [...document.querySelectorAll<HTMLElement>('.entry')];
  const empty = document.querySelector<HTMLElement>('#empty');
  input?.addEventListener('input', () => {
    const query = input.value.trim().toLowerCase();
    let count = 0;
    entries.forEach(entry => { const match = (entry.dataset.search || '').includes(query); entry.hidden = !match; if (match) count++; });
    if (empty) empty.hidden = count !== 0;
  });
</script>
<style>.listing{padding-top:77px;min-height:48vh}.page-heading span{color:var(--green)}.search-label{font:11px 'DM Mono',monospace;color:var(--green);display:block;margin-top:38px;margin-bottom:10px}input{padding:15px 17px;display:block;width:100%;color:var(--text);background:var(--panel);border:1px solid var(--border);border-radius:7px;outline:0;margin-bottom:28px;font:14px Inter,sans-serif}input:focus{border-color:var(--green)}.entry{min-width:0}.entry[hidden]{display:none}#empty{color:var(--muted)}.empty-state{margin-top:35px;border:1px dashed #315048;background:var(--panel);border-radius:10px;padding:36px}.empty-state h2{font-size:21px;margin:10px 0 8px}.empty-state p{color:var(--muted);margin:0;font-size:14px}</style>
