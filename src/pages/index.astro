---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import { publishedPosts } from '../lib/posts';
const posts = await publishedPosts();
---
<Base title="Home">
  <section class="shell hero">
    <div class="eyebrow"><span class="dot"></span> INDEPENDENT SECURITY RESEARCH</div>
    <h1>Dissecting threats.<br /><span>Understanding systems.</span></h1>
    <p class="hero-copy">Deep dives into malware analysis, reverse engineering, threat intelligence, and the techniques behind modern attacks.</p>
    <div class="hero-actions"><a class="primary" href="/blog/">Explore research ↗</a><a class="secondary" href="https://github.com/tuna1999" target="_blank" rel="noopener noreferrer">View GitHub ↗</a></div>
    <div class="terminal"><div class="terminal-header"><span class="lights">● ● ●</span><span>research@tuna:~</span><span>⌁</span></div><div class="terminal-body"><p><span class="prompt">❯</span> whoami</p><p class="out">security researcher / reverse engineer / developer</p><p><span class="prompt">❯</span> cat interests.txt</p><p class="out">malware-analysis&nbsp; reverse-engineering&nbsp; threat-intel</p><p><span class="prompt">❯</span> <span class="cursor">▌</span></p></div></div>
  </section>
  <section class="shell latest">
    <div class="section-top"><div><div class="eyebrow">FIELD NOTES / {String(posts.length).padStart(3, '0')}</div><h2 class="section-heading">Latest research</h2></div>{posts.length > 0 && <a class="read-more" href="/blog/">All articles →</a>}</div>
    {posts.length > 0
      ? <div class="post-grid">{posts.slice(0, 4).map(post => <PostCard post={post} />)}</div>
      : <div class="empty-state"><span class="eyebrow">NO PUBLICATIONS YET</span><h3>Research notes coming soon.</h3><p>This space is ready for upcoming investigations and technical write-ups.</p></div>
    }
  </section>
  <section class="shell focuses"><div class="eyebrow">AREAS OF FOCUS</div><div class="focus-grid"><div><span>01 /</span><h3>Malware Analysis</h3><p>Static and dynamic analysis, behavioral triage and detection engineering.</p></div><div><span>02 /</span><h3>Reverse Engineering</h3><p>Binary formats, debuggers, decompilers and protocol internals.</p></div><div><span>03 /</span><h3>Threat Intelligence</h3><p>Campaign tracking, adversary tradecraft and defensible indicators.</p></div></div></section>
</Base>
<style>
.hero{padding-top:90px;padding-bottom:85px}.dot{display:inline-block;background:var(--green);width:8px;height:8px;border-radius:50%;margin-right:9px;box-shadow:0 0 17px var(--green)}h1{font-size:clamp(43px,6.2vw,78px);line-height:1.13;letter-spacing:-.065em;margin:25px 0;max-width:900px}h1 span{color:var(--green)}.hero-copy{max-width:610px;color:var(--muted);font-size:17px;line-height:1.85}.hero-actions{display:flex;gap:13px;flex-wrap:wrap;margin-top:32px}.primary,.secondary{padding:13px 19px;border-radius:6px;font:500 12px 'DM Mono',monospace}.primary{background:var(--green);color:#09241a}.primary:hover{background:#adffd4;color:#09241a}.secondary{border:1px solid var(--border)}.terminal{margin-top:72px;border:1px solid #2b4246;background:#0d171c;border-radius:10px;max-width:760px;box-shadow:0 24px 75px #0003}.terminal-header{border-bottom:1px solid #233740;display:flex;justify-content:space-between;padding:11px 19px;color:#7f969e;font:11px 'DM Mono',monospace}.lights{letter-spacing:4px;color:#b9a76e}.terminal-body{padding:18px 24px;font:12px 'DM Mono',monospace;line-height:2}.terminal-body p{margin:0}.prompt,.cursor{color:var(--green)}.out{color:#8aa4a5;padding-left:18px}.latest{padding-top:24px}.latest h2{margin-top:12px}.empty-state{border:1px dashed #315048;border-radius:10px;padding:42px;background:var(--panel)}.empty-state h3{font-size:21px;margin:11px 0 8px}.empty-state p{margin:0;color:var(--muted);font-size:13px}.focuses{margin-top:90px;border-top:1px solid var(--border);padding-top:37px}.focus-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:32px;margin-top:24px}.focus-grid span{color:var(--green);font:12px 'DM Mono',monospace}.focus-grid h3{font-size:17px;margin:12px 0}.focus-grid p{color:var(--muted);font-size:13px}@media(max-width:700px){.hero{padding-top:55px;padding-bottom:55px}.terminal{margin-top:45px}.focus-grid{grid-template-columns:1fr;gap:15px}.focuses{margin-top:55px}.empty-state{padding:25px}}
</style>
